{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "services": [
      {
        "name": "metabase",
        "mounts": [
          {
            "type": "volume",
            "target": "/metabase-data",
            "name": "metabase-data"
          }
        ]
      }
    ]
  }
}
